# DevFlow - cấu hình môi trường. Sao chép thành `.env` (chạy local, tự đọc khi `npm start`)
# hoặc /etc/devflow.env (systemd EnvironmentFile). Biến đã có sẵn trong môi trường không bị `.env` ghi đè.

# Chế độ chạy: local (máy cá nhân, không đăng nhập, bind 127.0.0.1) hoặc server (VPS, có đăng nhập, bind 0.0.0.0).
DEVFLOW_MODE=local

# Địa chỉ lắng nghe. Để trống: 127.0.0.1 (local) hoặc 0.0.0.0 (server).
HOST=
# Cổng web.
PORT=3700

# Thư mục dữ liệu: SQLite, workspace từng yêu cầu, template tải lên, cache bản đồ mã nguồn.
DATA_DIR=./data

# Khóa mã hóa token GitLab (AES-256-GCM). BẮT BUỘC ở chế độ server (chuỗi ngẫu nhiên dài, ví dụ: openssl rand -hex 32).
# Local: để trống, DevFlow tự tạo DATA_DIR/secret.key. Đổi khóa sẽ làm mất token đã lưu.
SECRET_KEY=

# Lệnh Claude Code (đường dẫn đầy đủ nếu không nằm trong PATH). Có thể đổi trong trang Cài đặt.
CLAUDE_BIN=claude
# Tham số đặt trước tham số của claude (JSON mảng chuỗi hoặc cách nhau bằng dấu cách). Chủ yếu dùng khi kiểm thử.
CLAUDE_BIN_ARGS=
# 1 = dùng Claude giả lập (chỉ cho kiểm thử tự động, KHÔNG dùng khi chạy thật).
CLAUDE_MOCK=0

# Số job Claude chạy đồng thời. Để trống: 1 (local) hoặc 2 (server). Mỗi job tiêu hao hạn mức subscription.
MAX_CONCURRENT_JOBS=
# Số ngày link khảo sát khách hàng còn hiệu lực.
SURVEY_TTL_DAYS=14
# URL công khai (HTTPS) của DevFlow, dùng tạo link khảo sát và kiểm tra Origin ở chế độ server. Ví dụ: https://devflow.example.com
PUBLIC_BASE_URL=

# GitLab: địa chỉ (ví dụ https://gitlab.example.com), PAT quyền api + write_repository, group mặc định khi tạo project mới.
# Có thể nhập/ghi đè trong trang Cài đặt; mỗi người dùng có thể đặt token riêng ở trang Tài khoản.
GITLAB_URL=
GITLAB_TOKEN=
GITLAB_DEFAULT_GROUP=

# Số phút tạm dừng khi Claude báo chạm giới hạn subscription; hết thời gian DevFlow tự chạy lại.
RATE_LIMIT_PAUSE_MIN=30

# Sau reverse proxy (Caddy): true, hoặc số tầng proxy (thường 1), để lấy IP khách từ X-Forwarded-For (rate limit đăng nhập/khảo sát).
# Chỉ bật khi thật sự có proxy; mặc định false.
TRUST_PROXY=false

# (Tùy chọn) Android SDK: nếu đặt, Tester dùng emulator cho phần mobile; nếu không, phần giao diện mobile được đánh dấu PE.
# ANDROID_HOME=
