# DevFlow - cấu hình môi trường. Sao chép thành `.env` (chạy local, tự đọc khi `npm start`)
# hoặc /etc/devflow.env (systemd EnvironmentFile). Biến đã có sẵn trong môi trường không bị `.env` ghi đè.

# Chế độ chạy: local (máy cá nhân, không đăng nhập, bind 127.0.0.1) hoặc server (VPS, có đăng nhập, bind 0.0.0.0).
DEVFLOW_MODE=local

# Địa chỉ lắng nghe. Để trống: 127.0.0.1 (local) hoặc 0.0.0.0 (server).
HOST=
# Cổng web.
PORT=3700

# Thư mục dữ liệu: SQLite, workspace từng yêu cầu, template tải lên, cache bản đồ mã nguồn.
DATA_DIR=./data

# Khóa mã hóa token GitLab (AES-256-GCM). BẮT BUỘC ở chế độ server (chuỗi ngẫu nhiên dài, ví dụ: openssl rand -hex 32).
# Local: để trống, DevFlow tự tạo DATA_DIR/secret.key. Đổi khóa sẽ làm mất token đã lưu.
SECRET_KEY=

# Lệnh Claude Code (đường dẫn đầy đủ nếu không nằm trong PATH). Chỉ đặt ở đây, không đổi được trong trang Cài đặt.
# VPS/systemd: PATH không có ~/.local/bin, hãy dùng đường dẫn đầy đủ, ví dụ /opt/devflow/.local/bin/claude.
# Windows: có thể trỏ thẳng tới file .cmd (ví dụ C:\Users\<tên>\AppData\Roaming\npm\claude.cmd).
CLAUDE_BIN=claude
# Tham số đặt trước tham số của claude (JSON mảng chuỗi hoặc cách nhau bằng dấu cách). Chủ yếu dùng khi kiểm thử.
CLAUDE_BIN_ARGS=
# 1 = dùng Claude giả lập (chỉ cho kiểm thử tự động, KHÔNG dùng khi chạy thật).
CLAUDE_MOCK=0

# Số job Claude chạy đồng thời (toàn hệ thống). Để trống: 1 (local) hoặc 4 (server). Mỗi job tiêu hao hạn mức subscription.
MAX_CONCURRENT_JOBS=
# Số ngày link khảo sát khách hàng còn hiệu lực.
SURVEY_TTL_DAYS=14
# URL công khai (HTTPS) của DevFlow, dùng tạo link khảo sát và kiểm tra Origin. BẮT BUỘC ở chế độ server. Ví dụ: https://devflow.example.com
PUBLIC_BASE_URL=

# GitLab: địa chỉ (ví dụ https://gitlab.example.com), PAT quyền api + write_repository, group mặc định khi tạo project mới.
# Có thể nhập/ghi đè trong trang Cài đặt; mỗi người dùng có thể đặt token riêng ở trang Tài khoản.
GITLAB_URL=
GITLAB_TOKEN=
GITLAB_DEFAULT_GROUP=

# Số phút tạm dừng khi Claude báo chạm giới hạn subscription; hết thời gian DevFlow tự chạy lại.
RATE_LIMIT_PAUSE_MIN=30
# Thời gian tối đa (phút) cho một lần chạy Claude; quá hạn thì dừng tiến trình. 0 = không giới hạn.
STAGE_TIMEOUT_MIN=120

# Ngưỡng nỗ lực (man-hour): CR có effort_delta_mh vượt ngưỡng (hoặc có mục bỏ bớt) luôn chờ người duyệt, kể cả chế độ auto.
CR_AUTO_ACCEPT_MAX_MH=40

# Sau reverse proxy (Caddy): true, hoặc số tầng proxy (thường 1), để lấy IP khách từ X-Forwarded-For (rate limit đăng nhập/khảo sát).
# Chỉ bật khi thật sự có proxy; mặc định false.
TRUST_PROXY=false

# (Tùy chọn) Android SDK: nếu đặt, Tester dùng emulator cho phần mobile; nếu không, phần giao diện mobile được đánh dấu PE.
# ANDROID_HOME=

# ---- v3 nhiều người dùng (VPS dùng chung) ----
# Đăng nhập Google (OIDC). BẮT BUỘC ở chế độ server. Callback: <PUBLIC_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Tên miền email được phép đăng nhập (cách nhau dấu phẩy), ví dụ: example.com,corp.example.com
# PHẢI khác rỗng: để trống thì mọi lần đăng nhập đều bị từ chối.
ALLOWED_EMAIL_DOMAINS=
# Tài khoản được gán quyền ngay lần đăng nhập Google đầu tiên; người khác là member chưa có phòng.
ADMIN_EMAILS=
CTO_EMAILS=
# Trưởng/phó phòng, theo phòng: DEV:a@x,b@x;SGLOBAL:c@x
HEAD_EMAILS=
DEPUTY_EMAILS=
# Thư mục gốc chứa project (cách nhau dấu phẩy, đường dẫn tuyệt đối).
PROJECT_ROOTS=
# Số job Claude chạy đồng thời trên mỗi seat (mỗi người một seat).
SEAT_CONCURRENCY=1
# Đường dẫn dfctl (công cụ đặc quyền tạo user hệ điều hành/nhóm, cài bằng scripts/install-server.sh).
# Để trống = /usr/local/lib/devflow/dfctl. Server mode không chạy nếu thiếu.
DFCTL_PATH=
# (Tùy chọn) tên tài khoản admin cục bộ dùng mật khẩu khi Google hỏng. Để trống = tắt.
# Đặt mật khẩu: BREAKGLASS_PASSWORD='<>=12 ký tự>' npm run admin:set-password -- <tên>  (không ghi mật khẩu vào file này)
BREAKGLASS_ADMIN=
