<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= it.title %> - DevFlow</title>
<link rel="stylesheet" href="/static/app.css">
<script src="/static/htmx.min.js" defer></script>
<script src="/static/app.js" defer></script>
</head>
<body>
<header class="topbar">
  <a class="brand" href="/">DevFlow</a>
  <% if (it.user) { %>
  <nav>
    <% if (it.mode === 'server') { %>
    <a href="/">Việc của tôi</a>
    <a href="/projects">Dự án</a>
    <a href="/requests">Yêu cầu</a>
    <a href="/seat">Claude của tôi</a>
    <a href="/templates">Mẫu tài liệu</a>
    <% if (it.user.sysRole === 'head' || it.user.sysRole === 'deputy') { %><a href="/dept/pm">PM của phòng</a><% } %>
    <% if (['admin', 'cto', 'head', 'deputy'].includes(it.user.sysRole)) { %><a href="/oversight/projects">Giám sát</a><% } %>
    <% if (it.user.sysRole === 'admin' || it.user.role === 'admin') { %><a href="/settings">Cài đặt</a><a href="/admin/users">Người dùng</a><% } %>
    <% } else { %>
    <a href="/">Yêu cầu</a>
    <a href="/templates">Mẫu tài liệu</a>
    <a href="/settings">Cài đặt</a>
    <% } %>
  </nav>
  <div class="who">
    <span><%= it.user.username %></span>
    <% if (it.mode === 'server') { %>
    <form method="post" action="/logout" class="inline"><button class="link" type="submit">Đăng xuất</button></form>
    <% } %>
  </div>
  <% } %>
</header>
<main class="container">
<% if (it.flash) { %><div class="flash <%= it.flashKind === 'error' ? 'flash-error' : 'flash-ok' %>"><%= it.flash %></div><% } %>
<%~ it.body %>
</main>
</body>
</html>
