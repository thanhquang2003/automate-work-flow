<h1>Tạo yêu cầu mới</h1>
<form method="post" action="/requests" enctype="multipart/form-data" class="card stack">
  <label>Tiêu đề * <input name="title" required value="<%= it.form.title || '' %>"></label>
  <label>Mô tả yêu cầu * <textarea name="description" rows="8" required><%= it.form.description || '' %></textarea></label>
  <label>Yêu cầu hiệu năng <textarea name="perf_req" rows="3"><%= it.form.perf_req || '' %></textarea></label>
  <label>Yêu cầu phi chức năng <textarea name="nonfunc_req" rows="3"><%= it.form.nonfunc_req || '' %></textarea></label>
  <label>Tệp đính kèm (tối đa 50MB mỗi tệp) <input type="file" name="files" multiple></label>
  <fieldset>
    <legend>Loại dự án</legend>
    <label class="check"><input type="radio" name="project_kind" value="new" <%= (it.form.project_kind || 'new') === 'new' ? 'checked' : '' %>> Dự án mới</label>
    <label class="check"><input type="radio" name="project_kind" value="existing" <%= it.form.project_kind === 'existing' ? 'checked' : '' %>> Dự án có sẵn</label>
  </fieldset>
  <label>GitLab project (đường dẫn dự án có sẵn, hoặc tên dự án mới) <input name="gitlab_project" placeholder="nhom/ten-du-an" value="<%= it.form.gitlab_project || '' %>"></label>
  <fieldset>
    <legend>Loại phần mềm</legend>
    <% const labels = { web: 'Web', mobile: 'Mobile', api: 'API', background: 'Tiến trình nền' }; %>
    <% for (const t of it.SOFTWARE_TYPES) { %>
    <label class="check"><input type="checkbox" name="software_types" value="<%= t %>" <%= (it.form.software_types || []).includes(t) ? 'checked' : '' %>> <%= labels[t] %></label>
    <% } %>
  </fieldset>
  <fieldset>
    <legend>Chế độ chạy</legend>
    <label class="check"><input type="radio" name="run_mode" value="review" <%= (it.form.run_mode || 'review') === 'review' ? 'checked' : '' %>> Duyệt từng bước</label>
    <label class="check"><input type="radio" name="run_mode" value="auto" <%= it.form.run_mode === 'auto' ? 'checked' : '' %>> Tự động</label>
  </fieldset>
  <div><button class="btn primary" type="submit">Tạo và bắt đầu</button> <a class="btn" href="/">Hủy</a></div>
</form>
