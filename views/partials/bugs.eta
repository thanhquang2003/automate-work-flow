<% if (it.bugs.length === 0) { %><p class="muted">Chưa có bug nào.</p><% } else { %>
<table class="list">
  <thead><tr><th>Test case</th><th>Issue GitLab</th><th>Số lần sửa</th><th>Trạng thái</th></tr></thead>
  <tbody>
  <% for (const b of it.bugs) { %>
  <tr><td><%= b.tcId %></td>
  <td><% if (b.issueUrl) { %><a href="<%= b.issueUrl %>" target="_blank" rel="noopener"><%= b.gitlabIid ? '#' + b.gitlabIid : 'Mở issue' %></a><% } else if (b.gitlabIid) { %>#<%= b.gitlabIid %><% } %></td>
  <td><%= b.fixAttempts %></td><td><span class="badge"><%= b.status %></span></td></tr>
  <% } %>
  </tbody>
</table>
<% } %>
