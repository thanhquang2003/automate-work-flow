<% if (it.tasks.length === 0) { %><p class="muted">Chưa có task nào.</p><% } else { %>
<div class="table-wrap"><table class="list">
  <thead><tr><th>Mã</th><th>Task</th><th>Chức năng</th><th>Phụ thuộc</th><th>Trạng thái</th><th>Vòng review</th><th>Nhánh</th><th>MR</th></tr></thead>
  <tbody>
  <% for (const t of it.tasks) { %>
  <tr><td><%= t.id %></td><td><%= t.title %></td><td><%= t.featureId || '' %></td><td><%= t.dependsOn.join(', ') %></td>
  <td><span class="badge"><%= t.status %></span></td><td><%= t.reviewRounds %></td><td><%= t.branch || '' %></td><td><%= t.mrIid ? '!' + t.mrIid : '' %></td></tr>
  <% } %>
  </tbody>
</table></div>
<% } %>
