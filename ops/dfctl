#!/bin/bash
# dfctl — DevFlow's only privileged helper (spec v3 §6b.2). Installed root:root 0755 at
# /usr/local/lib/devflow/dfctl; the service user may run it through exactly one sudoers rule:
#   devflow ALL=(root) NOPASSWD: /usr/local/lib/devflow/dfctl
#
# Subcommands (every argument is validated before anything else happens):
#   provision-user <userId>                          OS account dfu-<id>, no login shell, private home
#   ensure-project-group <projectId> <path>          group dfp-<id>, project folder group-owned, setgid
#   set-members <projectId> [<userId>...]            exact member list of dfp-<id> (+ the service user)
#   run-claude <userId> <cwd> --run-id <runId> -- <claude args...>
#                                                    the configured claude binary as dfu-<id>, cwd must be a
#                                                    worktree of a project whose group the user is in;
#                                                    stdin/stdout/stderr pass through (prompt via stdin)
#   claude-auth <userId> status|logout
#   claude-auth <userId> login --run-id <runId>      `claude auth login` inside a pty (util-linux script)
#   stop-claude <userId> <runId>                     stop a run started with that run id (TERM, then KILL);
#                                                    leaves a stop marker so a run that has not started yet
#                                                    never starts (DevFlow cannot signal other users itself)
#   sweep-project <projectId> [<worktree>]          root sweep of the project's git dirs (also run before and
#                                                    after every run-claude); exit 86 when it fails
#   reap                                             stop dfctl scopes whose dfctl died (devflow.service
#                                                    ExecStopPost); also done before every sweep
#   --self-test                                      pure checks plus temp-dir runs as the calling user; never
#                                                    touches system state
#
# Design rules: root never writes inside a path that a non-root user controls (homes and project folders
# are changed through `setpriv` as their owner); programs run as other users through `setpriv`, which
# execs in place so stop-claude and the time limits reach the whole run; no value from the caller reaches
# a shell; project .git config/hooks/info stay owner-only (see HARDEN_SCRIPT); the claude
# binary and project roots come only from the root-owned /etc/devflow/dfctl.conf; DevFlow never sees,
# reads or stores Claude credentials (they stay in /var/lib/devflow/users/<id>/.claude, mode 0700).
set -euo pipefail
umask 022
IFS=$' \t\n'
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

readonly CONF_FILE=/etc/devflow/dfctl.conf
readonly REG_DIR=/var/lib/dfctl/projects
readonly RUN_DIR=/run/dfctl
readonly PACK_DIR=/var/lib/dfctl/packs
# Exit code of run-claude / sweep-project when the project's git dirs failed the root-side sweep.
readonly SWEEP_FAILED=86
readonly USERS_HOME=/var/lib/devflow/users
readonly SERVICE_USER=devflow
readonly USER_PREFIX=dfu-
readonly GROUP_PREFIX=dfp-
readonly RUN_MAX_SEC=86400
readonly LOGIN_MAX_SEC=600
readonly SHORT_MAX_SEC=60
readonly USER_PATH=/usr/local/bin:/usr/bin:/bin

# Exit 2 = rejected arguments, 1 = runtime failure.
usage_die() { printf 'dfctl: %s\n' "$*" >&2; printf 'usage: dfctl provision-user|ensure-project-group|set-members|run-claude|claude-auth|stop-claude|sweep-project|reap ... | --self-test\n' >&2; exit 2; }
die() { printf 'dfctl: %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------- pure validators (no side effects)

is_id() { [[ ${1-} =~ ^[1-9][0-9]{0,8}$ ]]; }
is_run_id() { [[ ${1-} =~ ^[A-Za-z0-9]{8,64}$ ]]; }
# Absolute, no control characters (newline would break the registry), sane length.
is_abs_path() {
  local p=${1-}
  [[ $p == /* ]] || return 1
  [[ $p != *[[:cntrl:]]* ]] || return 1
  [ ${#p} -le 4096 ]
}
# Canonical form: no ".", ".." or empty segments, no trailing slash (except "/").
is_canonical() {
  local p=${1-}
  is_abs_path "$p" || return 1
  [[ $p == / ]] && return 0
  [[ $p != */ && $p != *//* && $p != */./* && $p != */. && $p != */../* && $p != */.. ]]
}
# child strictly below parent (both canonical). The quoted parent is matched literally, never as a glob.
is_under() {
  local child=${1-} parent=${2-}
  [ -n "$parent" ] && [ "$parent" != / ] || return 1
  [[ $child == "$parent"/* ]]
}
# A run may only start inside <project>/.devflow/worktrees/<something>.
cwd_allowed() {
  local cwd=${1-} project=${2-}
  is_canonical "$cwd" && is_canonical "$project" || return 1
  is_under "$cwd" "$project/.devflow/worktrees"
}
# The claude binary path goes into `script -c "<cmd>"`, which /bin/sh parses: plain path characters only.
is_safe_bin() {
  local b=${1-}
  [[ $b =~ ^/[A-Za-z0-9._/+-]+$ ]] || return 1
  is_canonical "$b"
}

# Shape of every subcommand's arguments. Returns 0 or prints the reason and returns 2.
validate_args() {
  bad() { printf '%s\n' "$*"; }
  [ $# -ge 1 ] || { bad "missing subcommand"; return 2; }
  local cmd=$1; shift
  case "$cmd" in
    provision-user)
      [ $# -eq 1 ] || { bad "provision-user takes exactly <userId>"; return 2; }
      is_id "$1" || { bad "invalid user id"; return 2; } ;;
    ensure-project-group)
      [ $# -eq 2 ] || { bad "ensure-project-group takes <projectId> <path>"; return 2; }
      is_id "$1" || { bad "invalid project id"; return 2; }
      is_canonical "$2" && [ "$2" != / ] || { bad "project path must be absolute and canonical"; return 2; } ;;
    set-members)
      [ $# -ge 1 ] || { bad "set-members takes <projectId> [<userId>...]"; return 2; }
      is_id "$1" || { bad "invalid project id"; return 2; }
      shift
      local u
      for u in "$@"; do is_id "$u" || { bad "invalid user id"; return 2; }; done ;;
    run-claude)
      [ $# -ge 5 ] || { bad "run-claude takes <userId> <cwd> --run-id <runId> -- <args...>"; return 2; }
      is_id "$1" || { bad "invalid user id"; return 2; }
      is_abs_path "$2" || { bad "cwd must be an absolute path"; return 2; }
      [ "$3" = --run-id ] || { bad "expected --run-id"; return 2; }
      is_run_id "$4" || { bad "invalid run id"; return 2; }
      [ "$5" = -- ] || { bad "expected -- before claude arguments"; return 2; } ;;
    claude-auth)
      [ $# -ge 2 ] || { bad "claude-auth takes <userId> login|status|logout"; return 2; }
      is_id "$1" || { bad "invalid user id"; return 2; }
      case "$2" in
        status|logout) [ $# -eq 2 ] || { bad "claude-auth $2 takes no further arguments"; return 2; } ;;
        login)
          [ $# -eq 4 ] && [ "$3" = --run-id ] || { bad "claude-auth login needs --run-id <runId>"; return 2; }
          is_run_id "$4" || { bad "invalid run id"; return 2; } ;;
        *) bad "claude-auth action must be login, status or logout"; return 2 ;;
      esac ;;
    reap)
      [ $# -eq 0 ] || { bad "reap takes no arguments"; return 2; } ;;
    sweep-project)
      [ $# -eq 1 ] || [ $# -eq 2 ] || { bad "sweep-project takes <projectId> [<worktree>]"; return 2; }
      is_id "$1" || { bad "invalid project id"; return 2; }
      if [ $# -eq 2 ]; then is_canonical "$2" && [ "$2" != / ] || { bad "worktree must be absolute and canonical"; return 2; }; fi ;;
    stop-claude)
      [ $# -eq 2 ] || { bad "stop-claude takes <userId> <runId>"; return 2; }
      is_id "$1" || { bad "invalid user id"; return 2; }
      is_run_id "$2" || { bad "invalid run id"; return 2; } ;;
    *) bad "unknown subcommand"; return 2 ;;
  esac
  return 0
}

# ---------------------------------------------------------------- command builders (pure, covered by --self-test)

EXTRA_ENV=()
USER_CMD=()
# Sets USER_CMD: run "$@" as <uid>:<gid> (supplementary groups from /etc/group) with a clean environment,
# starting in <cwd>. setpriv sets the ids and execs in place: no fork, no new session, no PAM. So the program
# stays in the process group dfctl tracks and stop-claude / the hard time limit reach it (runuser would
# fork and setsid the program away from that group).
build_user_cmd() {
  local uid=$1 gid=$2 home=$3 cwd=$4; shift 4
  [ "${1-}" = -- ] && shift
  USER_CMD=(setpriv "--reuid=$uid" "--regid=$gid" --init-groups --no-new-privs --
    env -i -C "$cwd" "HOME=$home" "CLAUDE_CONFIG_DIR=$home/.claude" "PATH=$USER_PATH" LANG=C.UTF-8
    SHELL=/bin/sh TERM=dumb DISABLE_AUTOUPDATER=1 "${EXTRA_ENV[@]}" "$@")
}

# The seat's git trusts only this worktree and its project (command-scope safe.directory through
# GIT_CONFIG_*; replaces the old global safe.directory=*). Then USER_CMD runs <claude> <args...> in <cwd>.
build_run_claude_cmd() {
  local uid=$1 gid=$2 home=$3 cwd=$4 project=$5 claude=$6; shift 6
  [ "${1-}" = -- ] && shift
  local rest=${cwd#"$project/.devflow/worktrees/"}
  local wt="$project/.devflow/worktrees/${rest%%/*}"
  EXTRA_ENV=(GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_0=safe.directory "GIT_CONFIG_VALUE_0=$wt"
    GIT_CONFIG_KEY_1=safe.directory "GIT_CONFIG_VALUE_1=$project")
  build_user_cmd "$uid" "$gid" "$home" "$cwd" -- "$claude" "$@"
  EXTRA_ENV=()
}

# Devflow phase of the project sweep (run as the folder owner, devflow, never as root; the root phase
# sweep_root runs first). Args: <dir> <owner> <full 0|1> <group or ->.
# Makes the project folder group-shared for seats, but keeps everything git executes or reads as
# configuration or history it trusts owner-only: .git itself and its root files, config, hooks, info,
# objects/info (alternates), existing packs, submodule git dirs. Sticky bits stop seats from renaming
# DevFlow's .git, .devflow, worktree folders, objects/pack and objects/info out of the way; seats may still
# ADD loose objects and new packs. Every walk is `find -P` (never follows a symlink, including one given on
# the command line) and skips symlinks.
readonly HARDEN_SCRIPT='
set -u
umask 022
dir=$1 owner=$2 full=$3 grp=$4
fail() { printf "project hardening: %s\n" "$*" >&2; exit 1; }
# chmod every non-symlink found; an entry that vanished meanwhile (lock, tmp_pack) is not an error.
nochmod() {
  mode=$1; shift
  find -P "$@" ! -type l -print0 2>/dev/null | while IFS= read -r -d "" f; do
    chmod "$mode" "$f" 2>/dev/null || [ ! -e "$f" ] || exit 1
  done || fail "chmod $mode $*"
}
owned() { [ -z "$(find -P "$@" ! -user "$owner" -print -quit)" ]; }
cd -- "$dir" || fail "cannot enter $dir"
[ -d . ] && [ "$(stat -c %U .)" = "$owner" ] || fail "project folder not owned by $owner"
if [ "$grp" != - ]; then chgrp -h -- "$grp" . || fail "chgrp $grp"; fi
if [ "$full" = 1 ]; then
  find -P . -xdev ! -type l -exec chgrp -f -- "$grp" {} + 2>/dev/null || true
  find -P . -xdev ! -type l -exec chmod -f g+rwX,o-rwx {} + 2>/dev/null || true
  find -P . -xdev -type d ! -perm -2000 -exec chmod -f g+s {} + 2>/dev/null || true
fi
chmod 3770 . || fail "chmod project folder"
for d in .devflow .devflow/worktrees; do
  [ -e "$d" ] || [ -L "$d" ] || continue
  [ -d "$d" ] && [ ! -L "$d" ] && [ "$(stat -c %U -- "$d")" = "$owner" ] || fail "$d is not a directory owned by $owner"
  chmod 3770 -- "$d" || fail "chmod $d"
done
if [ -e .git ] || [ -L .git ]; then
  [ -d .git ] && [ ! -L .git ] && [ "$(stat -c %U .git)" = "$owner" ] || fail ".git is not a directory owned by $owner"
  [ -z "$(find -P .git -type l -print -quit)" ] || fail "symlinks under .git (the root sweep must run first)"
  chmod 2750 .git || fail "chmod .git"
  # index, HEAD, packed-refs, ORIG_HEAD, FETCH_HEAD... are created 0664; only DevFlow writes them.
  nochmod g-w,o-rwx .git -mindepth 1 -maxdepth 1 -type f
  for p in .git/config .git/hooks .git/info; do
    [ -e "$p" ] || continue
    owned "$p" || fail "$p contains entries not owned by $owner"
    nochmod g-w,o-rwx "$p"
  done
  if [ -e .git/objects ]; then
    [ -d .git/objects ] && [ "$(stat -c %U .git/objects)" = "$owner" ] || fail ".git/objects is not a directory owned by $owner"
    chmod 3770 .git/objects || fail "chmod .git/objects"
    [ -e .git/objects/info ] || mkdir .git/objects/info || fail "mkdir .git/objects/info"
    [ -d .git/objects/info ] && owned .git/objects/info || fail ".git/objects/info not owned by $owner"
    nochmod g-w,o-rwx .git/objects/info
    [ -e .git/objects/pack ] || mkdir .git/objects/pack || fail "mkdir .git/objects/pack"
    [ -d .git/objects/pack ] && owned .git/objects/pack || fail ".git/objects/pack has entries not owned by $owner (root sweep takes over new packs)"
    chmod 3770 .git/objects/pack || fail "chmod .git/objects/pack"
    nochmod g-w,o-rwx .git/objects/pack -mindepth 1 -maxdepth 1 -type f
  fi
  if [ -e .git/worktrees ]; then
    [ -d .git/worktrees ] || fail ".git/worktrees is not a directory"
    chmod 3770 .git/worktrees || fail "chmod .git/worktrees"
    # A seat cannot create submodule git dirs in its worktree git dir: modules/ is pre-created owner-only.
    for w in .git/worktrees/*; do
      [ -d "$w" ] || continue
      [ -e "$w/modules" ] || mkdir -m 2750 "$w/modules" || fail "mkdir $w/modules"
    done
  fi
  # Submodule git dirs (.git/modules, .git/worktrees/<n>/modules) at every level: owner-only.
  for m in .git/modules .git/worktrees/*/modules; do
    [ -e "$m" ] || continue
    [ -d "$m" ] || fail "$m is not a directory"
    owned "$m" || fail "$m contains entries not owned by $owner"
    nochmod g-w,o-rwx "$m"
  done
  # No automatic repacking: a seat must not be able to make git rewrite packs (gc --auto).
  if [ -f .git/config ] && [ "$(git config --file .git/config --get gc.auto 2>/dev/null)" != 0 ]; then
    git config --file .git/config gc.auto 0 || fail "set gc.auto"
    nochmod g-w,o-rwx .git/config
  fi
fi
exit 0
'

# Root phase of the project sweep, run while no process of the seat that just ran is alive. Never follows a
# symlink: deletions are `find -P ... -delete` (unlinkat relative to the parent), ownership changes `chown -h`.
# Args: <project .git> <worktree or ""> <owner uid> <group or ""> <pack manifest file>.
# Returns 1 with SWEEP_ERR set when something is left that DevFlow must not trust.
SWEEP_ERR=""
# Temporary files git leaves when killed (tmp_obj_* while finalising with link()+unlink(), tmp_pack_*,
# tmp_idx_*, *.lock). Those of a seat account with no live process are deleted; others are ignored by the
# checks below (git never reads them as objects).
TMP_NAMES=( \( -name 'tmp_obj_*' -o -name 'tmp_pack_*' -o -name 'tmp_idx_*' -o -name 'tmp_rev_*' -o -name '*.lock' \) )
seat_uid_dead() { ! pgrep -u "$1" >/dev/null 2>&1; }
STRAGGLER_DEAD=seat_uid_dead
clean_stragglers() {
  local g=$1 keep_uid=$2 o
  while IFS= read -r o; do
    [ -n "$o" ] || continue
    "$STRAGGLER_DEAD" "$o" || continue
    find -P "$g" -type f -uid "$o" "${TMP_NAMES[@]}" -delete 2>/dev/null || true
  done < <(find -P "$g" -type f ! -uid "$keep_uid" "${TMP_NAMES[@]}" -printf '%U\n' 2>/dev/null | LC_ALL=C sort -u)
}
sweep_root() {
  local g=$1 wt=$2 uid=$3 grp=$4 manifest=$5 z f n
  serr() { SWEEP_ERR=$*; return 1; }
  [ -d "$g" ] && [ ! -L "$g" ] || { serr "$g missing or a symlink"; return 1; }
  find -P "$g" -type l -delete 2>/dev/null || true
  z=$(find -P "$g" -type l -print -quit)
  [ -z "$z" ] || { serr "symlink could not be removed: $z"; return 1; }
  clean_stragglers "$g" "$uid"
  z=$(find -P "$g" -type f -links +1 ! \( -name 'tmp_*' -o -name '*.lock' \) -print -quit)
  [ -z "$z" ] || { serr "hard-linked file under .git: $z"; return 1; }
  [ "$(stat -c %u -- "$g")" = "$uid" ] || { serr "$g not owned by the service user"; return 1; }
  z=$(find -P "$g" -mindepth 1 -maxdepth 1 -type f ! -uid "$uid" -print -quit)
  [ -z "$z" ] || { serr "foreign-owned file: $z"; return 1; }
  for z in "$g/config" "$g/hooks" "$g/info" "$g/objects/info" "$g/modules" "$g"/worktrees/*/modules "$g"/worktrees/*/commondir "$g"/worktrees/*/gitdir; do
    [ -e "$z" ] || continue
    f=$(find -P "$z" ! -uid "$uid" -print -quit)
    [ -z "$f" ] || { serr "foreign-owned entry: $f"; return 1; }
  done
  for z in "$g/objects" "$g/objects/pack" "$g/worktrees"; do
    [ -e "$z" ] || continue
    [ -d "$z" ] && [ "$(stat -c %u -- "$z")" = "$uid" ] || { serr "$z not a directory owned by the service user"; return 1; }
  done
  if [ -d "$g/objects/pack" ]; then
    z=$(find -P "$g/objects/pack" -mindepth 1 -maxdepth 1 ! -type f -print -quit)
    [ -z "$z" ] || { serr "not a regular file in objects/pack: $z"; return 1; }
    # New packs a seat added are taken over, so they cannot be replaced later (pack/ is sticky).
    while IFS= read -r -d '' f; do
      n=${f##*/}
      case $n in tmp_*|*.lock) continue ;; esac
      [[ $n =~ ^pack-[0-9a-f]{40,64}\.(pack|idx|rev|bitmap|mtimes|promisor|keep)$ ]] || { serr "unexpected file in objects/pack: $n"; return 1; }
      chown -h -- "$uid${grp:+:$grp}" "$f" || { serr "cannot take over $n"; return 1; }
    done < <(find -P "$g/objects/pack" -mindepth 1 -maxdepth 1 -type f ! -uid "$uid" -print0)
    # A pack file with a known name but another inode or size was replaced.
    local cur name ino size old
    cur=$(find -P "$g/objects/pack" -mindepth 1 -maxdepth 1 -type f -name 'pack-*' -printf '%f %i %s\n' | LC_ALL=C sort)
    if [ -f "$manifest" ]; then
      while read -r name ino size; do
        [ -n "$name" ] || continue
        old=$(awk -v n="$name" '$1 == n { print $2 " " $3; exit }' "$manifest")
        if [ -n "$old" ] && [ "$old" != "$ino $size" ]; then serr "pack file replaced: $name"; return 1; fi
      done <<< "$cur"
    fi
    printf '%s\n' "$cur" > "$manifest.tmp" && mv -f -- "$manifest.tmp" "$manifest" || { serr "cannot write $manifest"; return 1; }
  fi
  if [ -n "$wt" ]; then
    f="$wt/.git"
    [ ! -L "$f" ] && [ -f "$f" ] || { serr "$f is not a regular file"; return 1; }
    [ "$(stat -c %u -- "$f")" = "$uid" ] && [ "$(stat -c %h -- "$f")" = 1 ] || { serr "$f was replaced"; return 1; }
    z=$(head -n 1 -- "$f")
    n=${z#"gitdir: $g/worktrees/"}
    [ "$n" != "$z" ] && [[ $n =~ ^[A-Za-z0-9._-]+$ ]] && [ "$n" != . ] && [ "$n" != .. ] || { serr "$f does not point into $g/worktrees"; return 1; }
    [ -d "$g/worktrees/$n" ] && [ ! -L "$g/worktrees/$n" ] || { serr "worktree git dir $n missing"; return 1; }
    # Back-pointer: that git dir must belong to THIS worktree (not another request's).
    z="$g/worktrees/$n/gitdir"
    [ -f "$z" ] && [ ! -L "$z" ] && [ "$(head -n 1 -- "$z")" = "$f" ] || { serr "$z does not point back to $f"; return 1; }
  fi
  return 0
}

# ---------------------------------------------------------------- system helpers (root only)

need_root() { [ "$(id -u)" -eq 0 ] || die "must run as root (through sudo)"; }

# A directory root controls: exists, not a symlink, owned by root, not writable by group/others.
root_dir_ok() {
  local d=$1
  [ -d "$d" ] && [ ! -L "$d" ] || return 1
  [ "$(stat -c %u -- "$d")" = 0 ] || return 1
  local mode; mode=$(stat -c %a -- "$d")
  (( (8#$mode & 8#022) == 0 ))
}
root_file_ok() {
  local f=$1
  [ -f "$f" ] && [ ! -L "$f" ] || return 1
  [ "$(stat -c %u -- "$f")" = 0 ] || return 1
  local mode; mode=$(stat -c %a -- "$f")
  (( (8#$mode & 8#022) == 0 ))
}

CONF_ROOTS=()
CONF_CLAUDE=""
CONF_ALLOW_NO_SCOPE=0
load_conf() {
  root_file_ok "$CONF_FILE" || die "$CONF_FILE missing or not root-owned/0644"
  local line key val raw_roots="" r
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in ''|'#'*) continue ;; esac
    key=${line%%=*}; val=${line#*=}
    case $key in
      PROJECT_ROOTS) raw_roots=$val ;;
      CLAUDE_BIN) CONF_CLAUDE=$val ;;
      ALLOW_NO_SYSTEMD_SCOPE) [ "$val" = 1 ] && CONF_ALLOW_NO_SCOPE=1 ;;
      *) die "unknown key in $CONF_FILE: $key" ;;
    esac
  done < "$CONF_FILE"
  local -a roots=()
  IFS=, read -r -a roots <<< "$raw_roots"   # no pathname expansion of entries
  for r in "${roots[@]}"; do
    is_canonical "$r" && [ "$r" != / ] && [ -d "$r" ] || die "bad PROJECT_ROOTS entry in $CONF_FILE"
    [ "$(realpath -e -- "$r")" = "$r" ] || die "PROJECT_ROOTS entry is not canonical (symlink?)"
    CONF_ROOTS+=("$r")
  done
  [ ${#CONF_ROOTS[@]} -gt 0 ] || die "PROJECT_ROOTS empty in $CONF_FILE"
  is_safe_bin "$CONF_CLAUDE" || die "bad CLAUDE_BIN in $CONF_FILE"
  local real; real=$(realpath -e -- "$CONF_CLAUDE") || die "CLAUDE_BIN does not exist"
  root_file_ok "$real" || die "CLAUDE_BIN must resolve to a root-owned file not writable by others"
  [ -x "$real" ] || die "CLAUDE_BIN not executable"
}

in_roots() {
  local p=$1 r
  for r in "${CONF_ROOTS[@]}"; do is_under "$p" "$r" && return 0; done
  return 1
}

user_home() { getent passwd "$1" | cut -d: -f6; }
in_group() { local u=$1 g=$2 x; for x in $(id -nG -- "$u"); do [ "$x" = "$g" ] && return 0; done; return 1; }

# Checks an existing dfu account against what provision-user creates; sets SEAT_UID, SEAT_GID, SEAT_HOME.
SEAT_UID="" SEAT_GID="" SEAT_HOME=""
seat_user() {
  local id=$1 u=${USER_PREFIX}$1
  getent passwd "$u" >/dev/null || die "user $u not provisioned"
  SEAT_UID=$(id -u -- "$u"); SEAT_GID=$(id -g -- "$u"); SEAT_HOME=$(user_home "$u")
  [ "$SEAT_UID" != 0 ] || die "user $u has uid 0"
  [ "$SEAT_HOME" = "$USERS_HOME/$id" ] || die "user $u has an unexpected home"
  [ -d "$SEAT_HOME" ] && [ ! -L "$SEAT_HOME" ] || die "home of $u missing"
  [ "$(stat -c %u -- "$SEAT_HOME")" = "$SEAT_UID" ] || die "home of $u is not owned by $u"
}

# Runs HARDEN_SCRIPT as the service user on <dir>.
harden_project() {
  local dir=$1 full=$2 grp=$3
  setpriv "--reuid=$SERVICE_USER" "--regid=$SERVICE_USER" --init-groups --no-new-privs -- \
    env -i "PATH=$USER_PATH" LANG=C.UTF-8 HOME=/nonexistent /bin/bash -c "$HARDEN_SCRIPT" harden "$dir" "$SERVICE_USER" "$full" "$grp"
}

registry_path() { cat -- "$REG_DIR/$1" 2>/dev/null || true; }

prepare_run_dir() {
  if [ -e "$RUN_DIR" ] || [ -L "$RUN_DIR" ]; then root_dir_ok "$RUN_DIR" || die "$RUN_DIR is not a root-owned directory"
  else install -d -m 0700 -o root -g root "$RUN_DIR"; fi
}

# ---------------------------------------------------------------- tracked runs (directory passed in, so --self-test can use a temp dir)

STOP_GRACE=5

# Field 22 of /proc/<pid>/stat (start time in clock ticks); the comm field may contain spaces.
proc_starttime() {
  local s
  s=$(cat -- "/proc/$1/stat" 2>/dev/null) || return 1
  s=${s##*) }
  local -a f
  read -r -a f <<< "$s"
  printf '%s\n' "${f[19]-}"
}

# TERM to the whole process group, KILL after STOP_GRACE seconds.
kill_group() {
  local pg=$1 i
  kill -TERM -- "-$pg" 2>/dev/null || return 0
  for ((i = 0; i < STOP_GRACE * 10; i++)); do
    kill -0 -- "-$pg" 2>/dev/null || return 0
    sleep 0.1
  done
  kill -KILL -- "-$pg" 2>/dev/null || true
}

TRACK_PIDF="" TRACK_STOPF=""
# Runs "$@" as the leader of a new session under a hard limit (TERM, then KILL after STOP_GRACE), tracked in
# <dir>/<uid>-<runId> as "<pid> <starttime>". A stop marker <dir>/<uid>-<runId>.stop (written by stop-claude,
# possibly before this run got going) is honoured before launch and right after the pid is recorded.
# Exits with the command's status. stdin is passed through explicitly (a background job would get /dev/null).
run_tracked_in() {
  local dir=$1 uid=$2 rid=$3 max=$4; shift 4
  TRACK_PIDF="$dir/$uid-$rid"; TRACK_STOPF="$dir/$uid-$rid.stop"
  ( set -o noclobber; : > "$TRACK_PIDF" ) 2>/dev/null || die "run id already in use"
  trap 'rm -f -- "$TRACK_PIDF" "$TRACK_PIDF.tmp" "$TRACK_STOPF"' EXIT
  [ -e "$TRACK_STOPF" ] && exit 143
  setsid timeout -s TERM -k "$STOP_GRACE" "$max" "$@" <&0 7>&- 9>&- &
  local child=$! st
  st=$(proc_starttime "$child" || true)
  printf '%s %s\n' "$child" "${st:-0}" > "$TRACK_PIDF.tmp"
  mv -f -- "$TRACK_PIDF.tmp" "$TRACK_PIDF"
  [ -e "$TRACK_STOPF" ] && kill_group "$child"
  local rc=0
  wait "$child" || rc=$?
  # Leftovers of the run (detached children in its systemd scope) are stopped too.
  # Nothing of this run may stay alive: the group (setsid'd leftovers are in the scope, below) ...
  kill_group "$child" >/dev/null 2>&1 || true
  # ... then the after-run steps (scope kill, root sweep). A failed sweep wins over the run's own status.
  if [ ${#TRACK_AFTER[@]} -gt 0 ]; then
    local arc=0
    "${TRACK_AFTER[@]}" || arc=$?
    [ "$arc" -eq 0 ] || rc=$arc
  fi
  exit "$rc"
}

# Leaves a stop marker, then kills the tracked group if it is running. Only kills a session that dfctl
# itself started: /proc/<pid> owned by <owner uid>, comm `timeout`, same start time as recorded, pgid == pid.
stop_in() {
  local dir=$1 uid=$2 rid=$3 owner=$4
  local pidf="$dir/$uid-$rid" stopf="$dir/$uid-$rid.stop"
  ( set -o noclobber; : > "$stopf" ) 2>/dev/null || true
  [ -f "$pidf" ] || { echo "not running"; return 0; }
  local pid="" st=""
  read -r pid st < "$pidf" || true
  [ -n "$pid" ] || { echo "stop requested"; return 0; }
  [[ $pid =~ ^[1-9][0-9]*$ && $st =~ ^[0-9]+$ ]] || die "bad pid file"
  [ -d "/proc/$pid" ] || { echo "not running"; return 0; }
  [ "$(stat -c %u -- "/proc/$pid")" = "$owner" ] || { echo "not running"; return 0; }
  [ "$(cat -- "/proc/$pid/comm" 2>/dev/null || true)" = timeout ] || { echo "not running"; return 0; }
  [ "$(proc_starttime "$pid" || true)" = "$st" ] || { echo "not running"; return 0; }
  [ "$(ps -o pgid= -p "$pid" | tr -d ' ')" = "$pid" ] || { echo "not running"; return 0; }
  kill_group "$pid"
  echo "stopped"
}

# Every tracked run also gets its own transient systemd scope (cgroup), so children that leave the process
# group (setsid, daemonised tool processes) are still found and killed: by stop-claude, at the end of the run,
# and, if dfctl itself died with devflow.service, by the reaper. RuntimeMaxSec bounds a scope whose dfctl is
# gone.
SCOPE_CMD=()
scope_unit() { printf 'dfctl-%s-%s.scope\n' "$1" "$2"; }
build_scope_cmd() {
  SCOPE_CMD=(systemd-run --scope --quiet --collect "--unit=$(scope_unit "$1" "$2")"
    "--property=RuntimeMaxSec=$(( $3 + 4 * STOP_GRACE ))" --)
}
have_systemd() { [ -d /run/systemd/system ] && command -v systemd-run >/dev/null 2>&1 && command -v systemctl >/dev/null 2>&1; }
scope_state() { systemctl show -p ActiveState --value -- "$1" 2>/dev/null || echo unknown; }
# Fails closed: returns 1 if the scope is still active after TERM, grace, KILL, grace.
stop_scope() {
  local unit st i sig
  unit=$(scope_unit "$1" "$2")
  for sig in TERM KILL; do
    st=$(scope_state "$unit")
    case $st in inactive|failed) return 0 ;; esac
    systemctl kill --signal="$sig" -- "$unit" >/dev/null 2>&1 || true
    for ((i = 0; i < STOP_GRACE * 10; i++)); do
      st=$(scope_state "$unit")
      case $st in inactive|failed) return 0 ;; esac
      sleep 0.1
    done
  done
  printf 'dfctl: scope %s still %s after TERM and KILL\n' "$unit" "$st" >&2
  return 1
}

# Pid of the live tracking `timeout` of <uid>-<rid> in <dir> (owner uid <owner>), or failure.
tracked_pid() {
  local dir=$1 uid=$2 rid=$3 owner=$4 pid="" st=""
  [ -f "$dir/$uid-$rid" ] || return 1
  read -r pid st < "$dir/$uid-$rid" 2>/dev/null || true
  [[ $pid =~ ^[1-9][0-9]*$ && $st =~ ^[0-9]+$ ]] || return 1
  [ -d "/proc/$pid" ] || return 1
  [ "$(stat -c %u -- "/proc/$pid" 2>/dev/null)" = "$owner" ] || return 1
  [ "$(cat -- "/proc/$pid/comm" 2>/dev/null || true)" = timeout ] || return 1
  [ "$(proc_starttime "$pid" || true)" = "$st" ] || return 1
  printf '%s\n' "$pid"
}
# "dfctl-<uid>-<rid>.scope" -> "<uid> <rid>" (pure).
parse_scope_name() {
  local n=${1-}
  [[ $n =~ ^dfctl-([1-9][0-9]{0,8})-([A-Za-z0-9]{8,64})\.scope$ ]] || return 1
  printf '%s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
}
# The run id of the dfctl scope of seat <uid> that a /proc/<pid>/cgroup text belongs to (pure).
scope_rid_of_cgroup() {
  local cg=${1-} uid=$2 line unit
  while IFS= read -r line; do
    unit=${line##*/}
    if [[ $unit =~ ^dfctl-${uid}-([A-Za-z0-9]{8,64})\.scope$ ]]; then printf '%s\n' "${BASH_REMATCH[1]}"; return 0; fi
  done <<< "$cg"
  return 1
}
# Orphan = a dfctl scope whose tracking dfctl/timeout is gone (devflow.service stop/restart/crash).
is_orphan_run() { ! tracked_pid "$1" "$2" "$3" "$4" >/dev/null; }
# Stops every orphaned dfctl scope (of seat <uid>, or all). Returns 1 if one could not be stopped.
# A stale pid file left behind is harmless: its pid is dead, so the run counts as not live.
reap_orphans() {
  local only=${1-} unit ur u r bad=0
  have_systemd || return 0
  while read -r unit _; do
    ur=$(parse_scope_name "$unit") || continue
    read -r u r <<< "$ur"
    [ -z "$only" ] || [ "$u" = "$only" ] || continue
    case $(scope_state "$unit") in active|activating|deactivating|reloading) ;; *) continue ;; esac
    is_orphan_run "$RUN_DIR" "$u" "$r" 0 || continue
    printf 'dfctl: stopping orphaned %s\n' "$unit" >&2
    stop_scope "$u" "$r" || bad=1
  done < <(systemctl list-units --all --type=scope --no-legend --plain 'dfctl-*.scope' 2>/dev/null)
  return "$bad"
}
# Backstop: every process of <seat os user> must be inside a live, tracked dfctl scope of <uid>. Others are
# killed and reported (return 1).
seat_strays() {
  local user=$1 uid=$2 p cg rid bad=0
  for p in $(pgrep -u "$user" 2>/dev/null); do
    cg=$(cat -- "/proc/$p/cgroup" 2>/dev/null) || continue
    if rid=$(scope_rid_of_cgroup "$cg" "$uid") && ! is_orphan_run "$RUN_DIR" "$uid" "$rid" 0; then continue; fi
    printf 'dfctl: process %s of %s is outside any live dfctl scope; killing it\n' "$p" "$user" >&2
    kill -KILL "$p" 2>/dev/null || true
    bad=1
  done
  return "$bad"
}

TRACK_AFTER=()
TRACK_POST=()
TRACK_UID="" TRACK_RID="" TRACK_SCOPE=0 TRACK_SEAT_USER=""
# After a tracked run: kill its whole systemd scope first (fail closed), make sure no process of the seat is
# left outside a live tracked scope, then the optional post step (root sweep).
after_tracked_run() {
  if [ "$TRACK_SCOPE" = 1 ]; then
    stop_scope "$TRACK_UID" "$TRACK_RID" || return "$SWEEP_FAILED"
    if [ -n "$TRACK_SEAT_USER" ]; then seat_strays "$TRACK_SEAT_USER" "$TRACK_UID" || return "$SWEEP_FAILED"; fi
  fi
  if [ ${#TRACK_POST[@]} -gt 0 ]; then "${TRACK_POST[@]}" || return $?; fi
  return 0
}
# Server runs require a systemd scope (fail closed). ALLOW_NO_SYSTEMD_SCOPE=1 in dfctl.conf is the explicit
# opt-out for machines without systemd: then only the process group is killed and the sweep guarantee
# (no seat process alive during the sweep) no longer holds.
run_tracked() {
  local uid=$1 rid=$2 max=$3; shift 3
  prepare_run_dir
  TRACK_UID=$uid; TRACK_RID=$rid; TRACK_AFTER=(after_tracked_run)
  if have_systemd; then
    TRACK_SCOPE=1
    build_scope_cmd "$uid" "$rid" "$max"
    run_tracked_in "$RUN_DIR" "$uid" "$rid" "$max" "${SCOPE_CMD[@]}" "$@"
  elif [ "$CONF_ALLOW_NO_SCOPE" = 1 ]; then
    TRACK_SCOPE=0
    run_tracked_in "$RUN_DIR" "$uid" "$rid" "$max" "$@"
  else
    die "systemd scopes are unavailable (systemd-run/systemctl or /run/systemd/system missing); refusing to start a seat run"
  fi
}

# fs.protected_hardlinks and fs.protected_symlinks must both be 1 (seats must not hard-link files they do
# not own into a project, nor make root follow their symlinks in sticky folders).
kernel_protections_ok() {
  local d=${1:-/proc/sys/fs}
  [ "$(cat -- "$d/protected_hardlinks" 2>/dev/null)" = 1 ] && [ "$(cat -- "$d/protected_symlinks" 2>/dev/null)" = 1 ]
}

# Per-worktree lock held by run-claude from its pre-run sweep to its post-run sweep (kill grace included).
# sweep-project <id> <worktree> takes it first, so it never runs while that worktree's run is still dying.
wt_lock_file() { printf '%s/wt-%s.lock\n' "$1" "$(printf '%s' "$2" | sha256sum | cut -c1-40)"; }

# cron/at must be denied to seat accounts (a seat could otherwise schedule processes outside any scope).
deny_cron_at() {
  local u=$1 etc=${2:-/etc} f
  for f in "$etc/cron.allow" "$etc/at.allow"; do
    if [ -e "$f" ] && grep -qxF -- "$u" "$f"; then printf 'dfctl: %s is listed in %s\n' "$u" "$f" >&2; return 1; fi
  done
  for f in "$etc/cron.deny" "$etc/at.deny"; do
    [ ! -L "$f" ] || { printf 'dfctl: %s is a symlink\n' "$f" >&2; return 1; }
    if [ ! -e "$f" ]; then : > "$f" && chmod 0644 "$f" || return 1; fi
    grep -qxF -- "$u" "$f" || printf '%s\n' "$u" >> "$f" || return 1
  done
}

# Root sweep + devflow hardening of one project, serialised per project, retried up to 3 times (git's
# link()+unlink() finalisation by a live writer can show nlink=2 for a moment). Returns SWEEP_FAILED on
# failure and records it in /var/lib/dfctl/sweep-failed/<projectId>; while that file exists every sweep of the
# project fails (an admin inspects the project and removes the file).
readonly FAILED_DIR=/var/lib/dfctl/sweep-failed
sweep_project() {
  local p=$1 wt=$2 pid=$3
  local uid; uid=$(id -u -- "$SERVICE_USER") || return "$SWEEP_FAILED"
  kernel_protections_ok || { printf 'dfctl: fs.protected_hardlinks and fs.protected_symlinks must be 1\n' >&2; return "$SWEEP_FAILED"; }
  prepare_run_dir
  install -d -m 0700 -o root -g root "$PACK_DIR" "$FAILED_DIR"
  root_dir_ok "$PACK_DIR" && root_dir_ok "$FAILED_DIR" || { printf 'dfctl: %s / %s not root-owned\n' "$PACK_DIR" "$FAILED_DIR" >&2; return "$SWEEP_FAILED"; }
  if [ -e "$FAILED_DIR/$pid" ]; then
    printf 'dfctl: an earlier sweep of project %s failed (%s); an admin must inspect it and remove %s\n' \
      "$pid" "$(head -c 300 -- "$FAILED_DIR/$pid" 2>/dev/null)" "$FAILED_DIR/$pid" >&2
    return "$SWEEP_FAILED"
  fi
  reap_orphans || { printf 'dfctl: an orphaned seat scope could not be stopped\n' >&2; return "$SWEEP_FAILED"; }
  local rc=0
  (
    flock -w 600 9 || { echo "dfctl: sweep lock timeout" >&2; exit "$SWEEP_FAILED"; }
    attempt=0
    until sweep_root "$p/.git" "$wt" "$uid" "${GROUP_PREFIX}$pid" "$PACK_DIR/$pid"; do
      attempt=$((attempt + 1))
      if [ "$attempt" -ge 3 ]; then
        printf 'dfctl: sweep of project %s failed: %s\n' "$pid" "$SWEEP_ERR" >&2
        printf '%s\n' "$SWEEP_ERR" > "$FAILED_DIR/$pid"
        exit "$SWEEP_FAILED"
      fi
      sleep 1
    done
    harden_project "$p" 0 - || { printf 'dfctl: hardening of project %s failed\n' "$pid" >&2; echo "hardening failed" > "$FAILED_DIR/$pid"; exit "$SWEEP_FAILED"; }
  ) 9> "$RUN_DIR/sweep-$pid.lock" || rc=$?
  return "$rc"
}

# ---------------------------------------------------------------- subcommands

cmd_provision_user() {
  local id=$1 u=${USER_PREFIX}$1 home=$USERS_HOME/$1
  root_dir_ok "$USERS_HOME" || die "$USERS_HOME must be a root-owned directory (run install-server.sh)"
  if getent passwd "$u" >/dev/null; then
    [ "$(user_home "$u")" = "$home" ] || die "existing $u has an unexpected home"
  else
    useradd --system --user-group --no-create-home --home-dir "$home" --shell /usr/sbin/nologin \
      --comment "DevFlow seat $id" "$u"
  fi
  local uid gid; uid=$(id -u -- "$u"); gid=$(id -g -- "$u")
  [ "$uid" != 0 ] || die "$u has uid 0"
  if [ ! -e "$home" ] && [ ! -L "$home" ]; then
    install -d -m 0700 -o "$uid" -g "$gid" "$home"   # parent is root-owned: safe to create as root
  fi
  [ -d "$home" ] && [ ! -L "$home" ] || die "home of $u is not a directory"
  [ "$(stat -c %u -- "$home")" = "$uid" ] || die "home of $u is not owned by $u"
  # Everything inside the home is done as the user (it may contain links the user planted). A global
  # safe.directory=* from earlier versions is removed: run-claude trusts only the current worktree.
  build_user_cmd "$uid" "$gid" "$home" "$home" -- /bin/sh -c '
    umask 077
    mkdir -p "$HOME/.claude"
    if command -v git >/dev/null 2>&1; then git config --global --unset-all safe.directory "^[*]$" 2>/dev/null || true; fi
  '
  "${USER_CMD[@]}"
  deny_cron_at "$u" || die "could not deny cron/at to $u"
  echo "provisioned $u"
}

cmd_ensure_project_group() {
  local pid=$1 path=$2 g=${GROUP_PREFIX}$1
  load_conf
  local real; real=$(realpath -e -- "$path") || die "project path does not exist"
  [ "$real" = "$path" ] || die "project path must not contain symlinks"
  [ -d "$real" ] || die "project path is not a directory"
  in_roots "$real" || die "project path is outside PROJECT_ROOTS"
  [ "$(stat -c %U -- "$real")" = "$SERVICE_USER" ] || die "project folder must be owned by $SERVICE_USER"

  install -d -m 0700 -o root -g root "$REG_DIR"
  root_dir_ok "$REG_DIR" || die "$REG_DIR is not root-owned"
  local f other first=0 cur
  cur=$(registry_path "$pid")
  if [ -n "$cur" ] && [ "$cur" != "$real" ]; then die "project $pid is registered with another path"; fi
  [ -z "$cur" ] && first=1
  for f in "$REG_DIR"/*; do
    [ -f "$f" ] || continue
    [ "${f##*/}" = "$pid" ] && continue
    other=$(cat -- "$f")
    if [ "$other" = "$real" ] || is_under "$real" "$other" || is_under "$other" "$real"; then
      die "path overlaps project ${f##*/}"
    fi
  done

  getent group "$g" >/dev/null || groupadd --system "$g"
  gpasswd -a "$SERVICE_USER" "$g" >/dev/null
  # Full tree walk only at registration; every call re-applies the .git protections.
  harden_project "$real" "$first" "$g" || die "could not prepare project folder $real"
  sweep_project "$real" "" "$pid" || exit "$SWEEP_FAILED"
  if [ $first -eq 1 ]; then
    local tmp="$REG_DIR/.$pid.$$"
    printf '%s\n' "$real" > "$tmp"
    chmod 0600 "$tmp"
    mv -f -- "$tmp" "$REG_DIR/$pid"
  fi
  echo "ensured $g for $real"
}

cmd_set_members() {
  local pid=$1 g=${GROUP_PREFIX}$1; shift
  [ -n "$(registry_path "$pid")" ] || die "project $pid not registered (ensure-project-group first)"
  getent group "$g" >/dev/null || die "group $g missing"
  local -A seen=()
  local list=$SERVICE_USER id u
  for id in "$@"; do
    [ -n "${seen[$id]-}" ] && continue
    seen[$id]=1
    u=${USER_PREFIX}$id
    getent passwd "$u" >/dev/null || die "user $u not provisioned"
    list+=",$u"
  done
  gpasswd -M "$list" "$g"
  echo "members of $g: $list"
}

cmd_run_claude() {
  local uid=$1 cwd=$2 rid=$4; shift 5
  load_conf
  seat_user "$uid"
  local u=${USER_PREFIX}$uid
  local real; real=$(realpath -e -- "$cwd") || die "cwd does not exist"
  [ -d "$real" ] || die "cwd is not a directory"
  local f p pid="" project=""
  for f in "$REG_DIR"/*; do
    [ -f "$f" ] || continue
    p=$(cat -- "$f")
    if cwd_allowed "$real" "$p" && in_roots "$p"; then pid=${f##*/}; project=$p; break; fi
  done
  [ -n "$pid" ] || die "cwd is not inside a project worktree"
  in_group "$u" "${GROUP_PREFIX}$pid" || die "user $u is not a member of project $pid"
  local rest=${real#"$project/.devflow/worktrees/"}
  local wt="$project/.devflow/worktrees/${rest%%/*}"
  prepare_run_dir
  exec 7> "$(wt_lock_file "$RUN_DIR" "$wt")"
  flock -w 30 7 || die "another run or sweep holds worktree $wt"
  reap_orphans "$uid" || exit "$SWEEP_FAILED"
  # Fail closed if the project's git dirs do not pass the sweep, before and after the run.
  sweep_project "$project" "$wt" "$pid" || exit "$SWEEP_FAILED"
  TRACK_POST=(sweep_project "$project" "$wt" "$pid")
  TRACK_SEAT_USER=$u
  build_run_claude_cmd "$SEAT_UID" "$SEAT_GID" "$SEAT_HOME" "$real" "$project" "$CONF_CLAUDE" -- "$@"
  umask 002
  run_tracked "$uid" "$rid" "$RUN_MAX_SEC" "${USER_CMD[@]}"
}

cmd_claude_auth() {
  local uid=$1 action=$2
  load_conf
  seat_user "$uid"
  reap_orphans "$uid" || exit "$SWEEP_FAILED"
  TRACK_SEAT_USER=${USER_PREFIX}$uid
  case "$action" in
    status|logout)
      # Tracked and scoped like every seat process, so nothing it starts outlives it.
      build_user_cmd "$SEAT_UID" "$SEAT_GID" "$SEAT_HOME" "$SEAT_HOME" -- "$CONF_CLAUDE" auth "$action"
      run_tracked "$uid" "auth$(od -An -N10 -tx1 /dev/urandom | tr -d ' \n')" "$SHORT_MAX_SEC" "${USER_CMD[@]}" ;;
    login)
      # A wide pty so the login URL is printed on one line. CONF_CLAUDE passed is_safe_bin.
      build_user_cmd "$SEAT_UID" "$SEAT_GID" "$SEAT_HOME" "$SEAT_HOME" -- \
        script -qfec "stty cols 500 rows 50 2>/dev/null; exec $CONF_CLAUDE auth login" /dev/null
      run_tracked "$uid" "$4" "$LOGIN_MAX_SEC" "${USER_CMD[@]}" ;;
  esac
}

cmd_sweep_project() {
  local pid=$1 wt=${2-}
  load_conf
  local p; p=$(registry_path "$pid")
  [ -n "$p" ] || die "project $pid not registered"
  in_roots "$p" || die "project $pid is outside PROJECT_ROOTS"
  if [ -n "$wt" ]; then
    [ "$(realpath -e -- "$wt" 2>/dev/null)" = "$wt" ] || die "worktree must exist and contain no symlinks"
    local name=${wt#"$p/.devflow/worktrees/"}
    [ "$name" != "$wt" ] && [[ $name =~ ^[^/]+$ ]] || die "worktree must be <project>/.devflow/worktrees/<name>"
  fi
  if [ -n "$wt" ]; then
    prepare_run_dir
    exec 7> "$(wt_lock_file "$RUN_DIR" "$wt")"
    # Waits for a run on this worktree to finish its post-run sweep (stop + kill grace included).
    flock -w 900 7 || { echo "dfctl: worktree $wt is still busy" >&2; exit "$SWEEP_FAILED"; }
  fi
  sweep_project "$p" "$wt" "$pid" || exit "$SWEEP_FAILED"
  echo "swept project $pid"
}

cmd_reap() {
  prepare_run_dir
  reap_orphans || exit "$SWEEP_FAILED"
  echo "reaped"
}

cmd_stop_claude() {
  prepare_run_dir
  stop_in "$RUN_DIR" "$1" "$2" 0
  if have_systemd; then stop_scope "$1" "$2" || exit "$SWEEP_FAILED"; fi
}

# ---------------------------------------------------------------- self-test

self_test() {
  local n=0 failed=0
  ok() { n=$((n + 1)); if "${@:2}"; then echo "ok - $1"; else echo "not ok - $1"; failed=$((failed + 1)); fi; }
  no() { n=$((n + 1)); if "${@:2}"; then echo "not ok - $1"; failed=$((failed + 1)); else echo "ok - $1"; fi; }
  quiet() { "$@" >/dev/null 2>&1; }

  echo "# bad user id"
  ok "id 1" is_id 1
  ok "id 123456789" is_id 123456789
  no "id 0" is_id 0
  no "id -1" is_id -1
  no "id 01 (leading zero)" is_id 01
  no "id empty" is_id ""
  no "id 1234567890 (too long)" is_id 1234567890
  no "id 1.5" is_id 1.5
  no "id with space" is_id "1 2"
  no "id with newline" is_id $'1\n2'
  no "provision-user abc" quiet validate_args provision-user abc
  no "set-members 1 2 x" quiet validate_args set-members 1 2 x
  no "stop-claude 0 abcdefgh" quiet validate_args stop-claude 0 abcdefgh

  echo "# arg injection"
  no "id 1;id" is_id "1;id"
  no "id \$(id)" is_id '$(id)'
  no "id --help" is_id --help
  no "run id with ../" is_run_id "../../etc/passwd"
  no "run id with ;" is_run_id "abcdefgh;rm"
  no "run id too short" is_run_id abc
  ok "run id hex" is_run_id 0123456789abcdef01234567
  no "provision-user extra arg" quiet validate_args provision-user 1 2
  no "run-claude without --run-id" quiet validate_args run-claude 1 /srv/p/.devflow/worktrees/A -- -p
  no "run-claude without --" quiet validate_args run-claude 1 /srv/p/.devflow/worktrees/A --run-id abcdefgh -p
  no "run-claude cwd relative" quiet validate_args run-claude 1 srv/p --run-id abcdefgh -- -p
  no "run-claude cwd option-like" quiet validate_args run-claude 1 -rf --run-id abcdefgh -- -p
  ok "run-claude well-formed (args after -- are opaque)" quiet validate_args run-claude 1 /srv/p/.devflow/worktrees/A --run-id abcdefgh -- -p '; rm -rf /' '$(id)'
  no "claude-auth unknown action" quiet validate_args claude-auth 1 'status;id'
  no "claude-auth login without run id" quiet validate_args claude-auth 1 login
  no "claude-auth status extra arg" quiet validate_args claude-auth 1 status --debug
  ok "claude-auth login well-formed" quiet validate_args claude-auth 1 login --run-id abcdefgh
  no "ensure-project-group path with newline" quiet validate_args ensure-project-group 1 $'/srv/p\n/etc'
  no "ensure-project-group path with .." quiet validate_args ensure-project-group 1 /srv/p/../../etc
  no "ensure-project-group path /" quiet validate_args ensure-project-group 1 /
  no "unknown subcommand" quiet validate_args frobnicate 1

  echo "# empty args"
  no "no subcommand" quiet validate_args
  no "empty subcommand" quiet validate_args ""
  no "provision-user without id" quiet validate_args provision-user
  no "provision-user empty id" quiet validate_args provision-user ""
  no "ensure-project-group without path" quiet validate_args ensure-project-group 1
  no "ensure-project-group empty path" quiet validate_args ensure-project-group 1 ""
  no "set-members without project" quiet validate_args set-members
  ok "set-members with no users (only the service user stays)" quiet validate_args set-members 1
  no "run-claude without args" quiet validate_args run-claude
  no "claude-auth without action" quiet validate_args claude-auth 1
  no "stop-claude without run id" quiet validate_args stop-claude 1

  echo "# cwd outside project"
  ok "worktree of project" cwd_allowed /srv/p/.devflow/worktrees/R1 /srv/p
  ok "subfolder of a worktree" cwd_allowed /srv/p/.devflow/worktrees/R1/src /srv/p
  no "worktrees folder itself" cwd_allowed /srv/p/.devflow/worktrees /srv/p
  no "project root" cwd_allowed /srv/p /srv/p
  no "project source outside worktrees" cwd_allowed /srv/p/src /srv/p
  no "request workspace (not a worktree)" cwd_allowed /srv/p/.devflow/requests/R1 /srv/p
  no "other project" cwd_allowed /srv/q/.devflow/worktrees/R1 /srv/p
  no "sibling with same prefix" cwd_allowed /srv/p2/.devflow/worktrees/R1 /srv/p
  no "non-canonical cwd with .." cwd_allowed /srv/p/.devflow/worktrees/R1/../../../../etc /srv/p
  no "glob in project path is literal" cwd_allowed /srv/x/.devflow/worktrees/R1 '/srv/*'
  no "is_under equal" is_under /srv/p /srv/p
  no "is_under parent /" is_under /etc /
  ok "is_under child" is_under /srv/p/a /srv/p

  echo "# symlink escape"
  local tmp; tmp=$(mktemp -d)
  mkdir -p "$tmp/proj/.devflow/worktrees/R1" "$tmp/outside"
  ln -s "$tmp/outside" "$tmp/proj/.devflow/worktrees/link"
  local proj; proj=$(realpath -e -- "$tmp/proj")
  local r1; r1=$(realpath -e -- "$tmp/proj/.devflow/worktrees/R1")
  local viaLink; viaLink=$(realpath -e -- "$tmp/proj/.devflow/worktrees/link")
  local viaDots; viaDots=$(realpath -e -- "$tmp/proj/.devflow/worktrees/R1/../../..")
  ok "real worktree resolves inside" cwd_allowed "$r1" "$proj"
  no "symlinked worktree resolving outside" cwd_allowed "$viaLink" "$proj"
  no "dot-dot resolving to project root" cwd_allowed "$viaDots" "$proj"
  rm -rf -- "$tmp"

  echo "# claude bin"
  ok "plain path" is_safe_bin /usr/local/bin/claude
  no "relative" is_safe_bin claude
  no "shell metachar" is_safe_bin '/usr/bin/claude;id'
  no "space" is_safe_bin '/opt/my claude/claude'
  no "dot-dot" is_safe_bin /usr/local/../bin/claude
  no "command substitution" is_safe_bin '/usr/bin/$(id)'

  echo "# user command (setpriv, no runuser)"
  build_run_claude_cmd 1001 1002 /var/lib/devflow/users/7 /srv/p/.devflow/worktrees/R1/src /srv/p /usr/local/bin/claude -- -p '; rm -rf /' '$(id)'
  local -a C=("${USER_CMD[@]}")
  has() { local x; for x in "${C[@]}"; do [ "$x" = "$1" ] && return 0; done; return 1; }
  ok "starts with setpriv" test "${C[0]}" = setpriv
  no "never uses runuser" has runuser
  ok "sets real+effective uid" has --reuid=1001
  ok "sets real+effective gid" has --regid=1002
  ok "initialises supplementary groups" has --init-groups
  ok "no new privileges" has --no-new-privs
  ok "clean environment" test "${C[5]} ${C[6]} ${C[7]} ${C[8]}" = "-- env -i -C"
  ok "chdir to cwd as the user" test "${C[9]}" = /srv/p/.devflow/worktrees/R1/src
  ok "CLAUDE_CONFIG_DIR in the seat home" has CLAUDE_CONFIG_DIR=/var/lib/devflow/users/7/.claude
  ok "git trusts the worktree root" has GIT_CONFIG_VALUE_0=/srv/p/.devflow/worktrees/R1
  ok "git trusts the project" has GIT_CONFIG_VALUE_1=/srv/p
  no "no global safe.directory=*" has 'GIT_CONFIG_VALUE_0=*'
  local n_c=${#C[@]}
  ok "claude binary then args verbatim" test "${C[n_c-4]}|${C[n_c-3]}|${C[n_c-2]}|${C[n_c-1]}" = "/usr/local/bin/claude|-p|; rm -rf /|\$(id)"
  ok "EXTRA_ENV reset after building" test ${#EXTRA_ENV[@]} -eq 0
  build_scope_cmd 7 abcdef12 100
  ok "systemd scope per run, bounded by RuntimeMaxSec" test "${SCOPE_CMD[*]}" = "systemd-run --scope --quiet --collect --unit=dfctl-7-abcdef12.scope --property=RuntimeMaxSec=$((100 + 4 * STOP_GRACE)) --"

  echo "# tracked runs and stop marker"
  local tdir me rc pid="" st="" i t0 bg mode
  tdir=$(mktemp -d); me=$(id -u)
  STOP_GRACE=1
  ( stop_in "$tdir" 5 abcdefgh "$me" ) >/dev/null 2>&1
  rc=0; ( run_tracked_in "$tdir" 5 abcdefgh 30 /bin/sh -c ": > '$tdir/ran'" ) </dev/null >/dev/null 2>&1 || rc=$?
  ok "stop before launch: command never runs" test ! -e "$tdir/ran"
  ok "stop before launch: exit 143" test "$rc" = 143
  ok "stop before launch: files cleaned" test ! -e "$tdir/5-abcdefgh" -a ! -e "$tdir/5-abcdefgh.stop"
  for mode in term kill; do
    local cmd='sleep 60 & sleep 60; wait'
    [ $mode = kill ] && cmd='trap "" TERM; sleep 60 & sleep 60; wait'
    ( run_tracked_in "$tdir" 5 "run${mode}xyz" 60 /bin/sh -c "$cmd" ) </dev/null >/dev/null 2>&1 &
    bg=$!
    pid=""
    for i in $(seq 1 50); do
      read -r pid st < "$tdir/5-run${mode}xyz" 2>/dev/null || true
      [ -n "$pid" ] && break
      sleep 0.1
    done
    t0=$SECONDS
    ( stop_in "$tdir" 5 "run${mode}xyz" "$me" ) >/dev/null 2>&1
    wait "$bg" 2>/dev/null || true
    sleep 0.3
    ok "stop ($mode): tracked run recorded its pid" test -n "$pid"
    no "stop ($mode): whole process group gone" quiet kill -0 -- "-${pid:-999999999}"
    ok "stop ($mode): finished promptly" test $((SECONDS - t0)) -le 8
    ok "stop ($mode): pid file and marker cleaned" test ! -e "$tdir/5-run${mode}xyz" -a ! -e "$tdir/5-run${mode}xyz.stop"
  done
  printf '99999999 1\n' > "$tdir/5-stalepid"
  ok "stale pid file (no such process) is ignored" quiet stop_in "$tdir" 5 stalepid "$me"
  printf '%s 1\n' "$$" > "$tdir/5-wrongstart"
  ok "pid of an unrelated process is never killed" quiet stop_in "$tdir" 5 wrongstart "$me"
  ok "the unrelated process is still alive" kill -0 "$$"
  STOP_GRACE=5
  rm -rf -- "$tdir"

  echo "# .git hardening"
  if command -v git >/dev/null 2>&1; then
    local hp me_u me_n me_g; hp=$(mktemp -d); me_u=$(id -u); me_n=$(id -un); me_g=$(id -gn)
    git -c core.hooksPath=/dev/null -c init.defaultBranch=main init -q "$hp/proj"
    mkdir -p "$hp/proj/.devflow/worktrees" "$hp/proj/.git/worktrees/R1" "$hp/proj/.git/info"
    : > "$hp/proj/.git/info/exclude"; : > "$hp/proj/.git/index"
    chmod -R g+w "$hp/proj"
    perm() { stat -c %a -- "$1"; }
    gw() { (( (8#$(perm "$1") & 8#020) != 0 )); }
    sticky() { (( (8#$(perm "$1") & 8#1000) != 0 )); }
    # The two phases as dfctl runs them: root sweep, then the devflow-side hardening.
    sweep_both() { sweep_root "$hp/proj/.git" "${3-}" "$me_u" "" "$hp/manifest" && bash -c "$HARDEN_SCRIPT" harden "$hp/proj" "$me_n" "$1" "$2"; }
    ok "first full sweep succeeds" quiet sweep_both 1 "$me_g"
    no ".git not group-writable" gw "$hp/proj/.git"
    no ".git/config not group-writable" gw "$hp/proj/.git/config"
    no ".git/HEAD (root file) not group-writable" gw "$hp/proj/.git/HEAD"
    no ".git/index (root file) not group-writable" gw "$hp/proj/.git/index"
    no ".git/hooks not group-writable" gw "$hp/proj/.git/hooks"
    no ".git/info not group-writable" gw "$hp/proj/.git/info"
    no ".git/info/exclude not group-writable" gw "$hp/proj/.git/info/exclude"
    ok ".git/objects group-writable and sticky" eval 'gw "$hp/proj/.git/objects" && sticky "$hp/proj/.git/objects"'
    ok ".git/objects/pack group-writable and sticky (add, not replace)" eval 'gw "$hp/proj/.git/objects/pack" && sticky "$hp/proj/.git/objects/pack"'
    ok ".git/refs stays group-writable" gw "$hp/proj/.git/refs"
    ok ".git/worktrees group-writable and sticky" eval 'gw "$hp/proj/.git/worktrees" && sticky "$hp/proj/.git/worktrees"'
    ok "project folder sticky" sticky "$hp/proj"
    ok ".devflow/worktrees sticky" sticky "$hp/proj/.devflow/worktrees"
    ok "gc.auto=0 in the protected config" test "$(git config --file "$hp/proj/.git/config" --get gc.auto)" = 0
    mkdir -p "$hp/proj/.git/modules/sub/hooks" "$hp/proj/.git/modules/sub/info" "$hp/proj/.git/modules/sub/modules/inner" \
      "$hp/proj/.git/worktrees/R2" "$hp/proj/.git/worktrees/R3/modules/sub"
    : > "$hp/proj/.git/modules/sub/config"; : > "$hp/proj/.git/modules/sub/modules/inner/config"
    : > "$hp/proj/.git/worktrees/R3/modules/sub/config"; : > "$hp/proj/.git/objects/info/alternates"
    printf 'pack\n' > "$hp/proj/.git/objects/pack/pack-1111111111111111111111111111111111111111.pack"
    printf 'idx\n' > "$hp/proj/.git/objects/pack/pack-1111111111111111111111111111111111111111.idx"
    ln -s /etc/hostname "$hp/proj/.git/objects/pack/pack-2222222222222222222222222222222222222222.pack"
    ln -s "$hp/elsewhere" "$hp/proj/.git/worktrees/R3/commondir"
    ln -s /etc/hostname "$hp/proj/.git/worktrees/R1/index"
    chmod -R g+w "$hp/proj/.git"
    ok "sweep with submodules, packs, alternates and planted symlinks" quiet sweep_both 1 "$me_g"
    for p in modules modules/sub modules/sub/config modules/sub/hooks modules/sub/info modules/sub/modules/inner \
      modules/sub/modules/inner/config worktrees/R3/modules worktrees/R3/modules/sub worktrees/R3/modules/sub/config \
      worktrees/R2/modules objects/info objects/info/alternates \
      objects/pack/pack-1111111111111111111111111111111111111111.pack objects/pack/pack-1111111111111111111111111111111111111111.idx; do
      no ".git/$p not group-writable" gw "$hp/proj/.git/$p"
    done
    ok "symlink inside .git removed (pack)" test ! -L "$hp/proj/.git/objects/pack/pack-2222222222222222222222222222222222222222.pack"
    ok "symlink inside .git removed (worktree index)" test ! -L "$hp/proj/.git/worktrees/R1/index"
    ok "symlink inside .git removed (commondir)" test ! -L "$hp/proj/.git/worktrees/R3/commondir"
    ok "modules pre-created owner-only in a worktree git dir" test -d "$hp/proj/.git/worktrees/R2/modules"
    local m1; m1=$(cat "$hp/manifest" 2>/dev/null)
    ok "sweep is idempotent" quiet sweep_both 0 -
    ok "sweep is idempotent (pack manifest unchanged)" test "$(cat "$hp/manifest" 2>/dev/null)" = "$m1"
    chmod g+w "$hp/proj/.git/config"
    ok "a later (non-full) pass strips g+w again" quiet sweep_both 0 -
    no "config fixed by the later pass" gw "$hp/proj/.git/config"

    local pk="$hp/proj/.git/objects/pack/pack-1111111111111111111111111111111111111111"
    ln "$pk.pack" "$hp/hardlink.pack"
    no "hard-linked pack refused" quiet sweep_root "$hp/proj/.git" "" "$me_u" "" "$hp/manifest"
    rm -f -- "$hp/hardlink.pack"
    ok "sweep passes again once the hard link is gone" quiet sweep_root "$hp/proj/.git" "" "$me_u" "" "$hp/manifest"
    cp -p "$pk.idx" "$hp/idx.copy"; printf 'evil idx\n' >> "$hp/idx.copy"
    chmod u+w "$hp/proj/.git/objects/pack"; mv -f "$hp/idx.copy" "$pk.idx"
    no "replaced idx detected" quiet sweep_root "$hp/proj/.git" "" "$me_u" "" "$hp/manifest"
    printf '%s\n' "$m1" > "$hp/manifest.after"
    no "foreign-owned entries refused" quiet sweep_root "$hp/proj/.git" "" "$((me_u + 1))" "" "$hp/manifest.after"

    mkdir -p "$hp/proj/.devflow/worktrees/R1"
    printf 'gitdir: %s/proj/.git/worktrees/R1\n' "$hp" > "$hp/proj/.devflow/worktrees/R1/.git"
    printf '%s/proj/.devflow/worktrees/R1/.git\n' "$hp" > "$hp/proj/.git/worktrees/R1/gitdir"
    rm -f -- "$hp/manifest"
    ok "worktree .git file pointing at its git dir passes" quiet sweep_root "$hp/proj/.git" "$hp/proj/.devflow/worktrees/R1" "$me_u" "" "$hp/manifest"
    printf '%s/proj/.devflow/worktrees/R9/.git\n' "$hp" > "$hp/proj/.git/worktrees/R1/gitdir"
    no "git dir whose gitdir back-pointer names another worktree refused" quiet sweep_root "$hp/proj/.git" "$hp/proj/.devflow/worktrees/R1" "$me_u" "" "$hp/manifest"
    printf '%s/proj/.devflow/worktrees/R1/.git\n' "$hp" > "$hp/proj/.git/worktrees/R1/gitdir"
    mkdir -p "$hp/proj/.git/objects/ab"
    printf 'x' > "$hp/proj/.git/objects/ab/tmp_obj_123"; ln "$hp/proj/.git/objects/ab/tmp_obj_123" "$hp/proj/.git/objects/ab/cdef"
    no "final object with nlink=2 (git link()+unlink() window) fails one pass" quiet sweep_root "$hp/proj/.git" "" "$me_u" "" "$hp/manifest"
    : > "$hp/proj/.git/objects/pack/tmp_pack_abc"; : > "$hp/proj/.git/index.lock"
    STRAGGLER_DEAD=self_dead_yes
    self_dead_yes() { return 0; }
    self_dead_no() { return 1; }
    clean_stragglers "$hp/proj/.git" "$((me_u + 1))"
    ok "stragglers of a dead seat deleted (tmp_obj, tmp_pack, lock)" test ! -e "$hp/proj/.git/objects/ab/tmp_obj_123" -a ! -e "$hp/proj/.git/objects/pack/tmp_pack_abc" -a ! -e "$hp/proj/.git/index.lock"
    ok "the finalised object stays (nlink back to 1)" test "$(stat -c %h "$hp/proj/.git/objects/ab/cdef")" = 1
    : > "$hp/proj/.git/objects/pack/tmp_pack_live"
    STRAGGLER_DEAD=self_dead_no
    clean_stragglers "$hp/proj/.git" "$((me_u + 1))"
    ok "stragglers of a live seat are kept" test -e "$hp/proj/.git/objects/pack/tmp_pack_live"
    ok "a tmp_pack in objects/pack is not a sweep failure" quiet sweep_root "$hp/proj/.git" "" "$me_u" "" "$hp/manifest"
    STRAGGLER_DEAD=seat_uid_dead
    printf 'gitdir: %s/other/.git/worktrees/R1\n' "$hp" > "$hp/proj/.devflow/worktrees/R1/.git"
    no "worktree .git file pointing elsewhere refused" quiet sweep_root "$hp/proj/.git" "$hp/proj/.devflow/worktrees/R1" "$me_u" "" "$hp/manifest"
    rm -f -- "$hp/proj/.devflow/worktrees/R1/.git"; ln -s "$hp/proj/.git" "$hp/proj/.devflow/worktrees/R1/.git"
    no "symlinked worktree .git refused" quiet sweep_root "$hp/proj/.git" "$hp/proj/.devflow/worktrees/R1" "$me_u" "" "$hp/manifest"

    mv "$hp/proj/.git/config" "$hp/config.real"
    ln -s "$hp/config.real" "$hp/proj/.git/config"
    no "devflow phase alone refuses a symlink under .git" quiet bash -c "$HARDEN_SCRIPT" harden "$hp/proj" "$me_n" 0 -
    ok "root sweep deletes it (no follow)" quiet sweep_root "$hp/proj/.git" "" "$me_u" "" "$hp/m2"
    ok "the symlink target is untouched" test -f "$hp/config.real"
    no "project not owned by the given owner is refused" quiet bash -c "$HARDEN_SCRIPT" harden "$hp/proj" nobody-such-user 0 -
    chmod -R u+w "$hp"
    rm -rf -- "$hp"
  else
    echo "ok - skipped (git not installed)"
  fi

  echo "# sweep-project arguments"
  ok "sweep-project id" quiet validate_args sweep-project 3
  ok "sweep-project id worktree" quiet validate_args sweep-project 3 /srv/p/.devflow/worktrees/R1
  no "sweep-project bad id" quiet validate_args sweep-project x
  no "sweep-project relative worktree" quiet validate_args sweep-project 3 srv/p
  no "sweep-project extra arg" quiet validate_args sweep-project 3 /a /b
  no "sweep-project no id" quiet validate_args sweep-project
  ok "reap" quiet validate_args reap
  no "reap with args" quiet validate_args reap 1

  echo "# orphan scopes and strays"
  ok "scope name parsed" test "$(parse_scope_name dfctl-7-abcdef12.scope)" = "7 abcdef12"
  no "foreign scope name ignored" quiet parse_scope_name user-1000.scope
  no "scope name with injection ignored" quiet parse_scope_name 'dfctl-7-abc;rm.scope'
  ok "cgroup of a seat run maps to its run id" test "$(scope_rid_of_cgroup '0::/system.slice/dfctl-7-abcdef12.scope' 7)" = abcdef12
  no "cgroup of another seat does not" quiet scope_rid_of_cgroup '0::/system.slice/dfctl-8-abcdef12.scope' 7
  no "cgroup outside dfctl scopes does not" quiet scope_rid_of_cgroup '0::/user.slice/user-1000.slice/session-3.scope' 7
  local od; od=$(mktemp -d)
  ok "no pid file -> orphan" is_orphan_run "$od" 7 abcdef12 "$me"
  printf '99999999 1\n' > "$od/7-deadbeef"
  ok "dead pid -> orphan" is_orphan_run "$od" 7 deadbeef "$me"
  printf '%s %s\n' "$$" "$(proc_starttime $$)" > "$od/7-notatimeout"
  ok "live pid that is not dfctl's timeout -> orphan" is_orphan_run "$od" 7 notatimeout "$me"
  ( run_tracked_in "$od" 7 livetrack 30 /bin/sh -c 'sleep 30' ) </dev/null >/dev/null 2>&1 &
  local lbg=$!
  for i in $(seq 1 50); do [ -s "$od/7-livetrack" ] && break; sleep 0.1; done
  no "live tracked run -> not an orphan" is_orphan_run "$od" 7 livetrack "$me"
  ( stop_in "$od" 7 livetrack "$me" ) >/dev/null 2>&1; wait "$lbg" 2>/dev/null || true
  ok "after its stop -> orphan" is_orphan_run "$od" 7 livetrack "$me"

  echo "# kernel protections, worktree lock, cron/at"
  mkdir -p "$od/fs"; echo 1 > "$od/fs/protected_hardlinks"; echo 1 > "$od/fs/protected_symlinks"
  ok "both protections on" kernel_protections_ok "$od/fs"
  echo 0 > "$od/fs/protected_symlinks"
  no "protected_symlinks=0 refused" kernel_protections_ok "$od/fs"
  echo 1 > "$od/fs/protected_symlinks"; echo 0 > "$od/fs/protected_hardlinks"
  no "protected_hardlinks=0 refused" kernel_protections_ok "$od/fs"
  no "missing values refused" kernel_protections_ok "$od/nowhere"
  ok "one lock file per worktree" test "$(wt_lock_file /run/dfctl /srv/p/.devflow/worktrees/A)" = "$(wt_lock_file /run/dfctl /srv/p/.devflow/worktrees/A)"
  no "different worktrees, different locks" test "$(wt_lock_file /run/dfctl /srv/p/.devflow/worktrees/A)" = "$(wt_lock_file /run/dfctl /srv/p/.devflow/worktrees/B)"
  local lk; lk=$(wt_lock_file "$od" /srv/p/.devflow/worktrees/A)
  ( exec 7> "$lk"; flock 7; sleep 2 ) &
  local hbg=$!
  sleep 0.3
  no "a held worktree lock blocks a second taker" quiet flock -w 0.5 "$lk" true
  wait "$hbg" 2>/dev/null || true
  ok "and is free after the run" quiet flock -w 2 "$lk" true
  mkdir -p "$od/etc"
  ok "cron/at denied" deny_cron_at dfu-7 "$od/etc"
  ok "cron/at deny idempotent" deny_cron_at dfu-7 "$od/etc"
  ok "listed once in cron.deny and at.deny" test "$(grep -cxF dfu-7 "$od/etc/cron.deny")$(grep -cxF dfu-7 "$od/etc/at.deny")" = 11
  echo dfu-7 > "$od/etc/cron.allow"
  no "refused when cron.allow lists the seat" quiet deny_cron_at dfu-7 "$od/etc"
  rm -rf -- "$od"

  if [ $failed -eq 0 ]; then echo "# all $n checks passed"; return 0; fi
  echo "# $failed of $n checks FAILED"; return 1
}

# ---------------------------------------------------------------- main

main() {
  if [ "${1-}" = --self-test ]; then [ $# -eq 1 ] || usage_die "--self-test takes no arguments"; self_test; exit $?; fi
  local why
  if ! why=$(validate_args "$@"); then usage_die "${why:-invalid arguments}"; fi
  need_root
  local cmd=$1; shift
  case "$cmd" in
    provision-user) cmd_provision_user "$@" ;;
    ensure-project-group) cmd_ensure_project_group "$@" ;;
    set-members) cmd_set_members "$@" ;;
    run-claude) cmd_run_claude "$@" ;;
    claude-auth) cmd_claude_auth "$@" ;;
    stop-claude) cmd_stop_claude "$@" ;;
    sweep-project) cmd_sweep_project "$@" ;;
    reap) cmd_reap ;;
  esac
}

main "$@"
